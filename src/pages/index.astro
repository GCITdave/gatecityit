<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Managed IT support, cybersecurity, and help desk for small businesses in Greensboro and across the Triad. Microsoft 365, backup, networks, phone systems, and compliance. Call (336) 743-1880." />
  <link rel="canonical" href="https://gatecityit.com/" />
  <title>Gate City IT | Managed IT Support in Greensboro, NC</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Gate City IT" />
  <meta property="og:title" content="Gate City IT | Managed IT Support in Greensboro, NC" />
  <meta property="og:description" content="Managed IT support, cybersecurity, and help desk for small businesses across the Triad." />
  <meta property="og:url" content="https://gatecityit.com/" />
  <meta property="og:image" content="https://gatecityit.com/GCIT-Skyline-Logo.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; color: #1a1a1a; line-height: 1.6; }
    a { color: inherit; text-decoration: none; }

    /* Colors */
    :root {
      --purple-dark:  #3b1f6e;
      --purple-mid:   #5a2d9c;
      --purple-light: #f3eefe;
      --purple-accent:#7c3fc8;
      --gray-light:   #f4f4f6;
      --gray-mid:     #6b7280;
      --gray-dark:    #374151;
      --white:        #ffffff;
    }

    /* Nav */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 32px;
      background: var(--purple-dark);
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .logo img {
      height: 56px;
      width: auto;
      display: block;
    }
    .nav-cta {
      background: var(--white);
      color: var(--purple-dark);
      padding: 10px 20px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      text-decoration: none;
    }
    .nav-cta:hover { background: var(--purple-light); }

    /* Hero */
    .hero {
      position: relative;
      padding: 80px 32px;
      text-align: center;
      border-bottom: 4px solid var(--purple-accent);
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url("/Aerial-Drone-Downtown-Greensboro-North-Carolina-NC-Skyline.jpg") center/cover no-repeat;
      filter: grayscale(100%);
      z-index: 0;
    }
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(59, 31, 110, 0.78);
      mix-blend-mode: multiply;
      z-index: 1;
    }
    .hero > * { position: relative; z-index: 2; }
    .hero h1 {
      font-size: clamp(28px, 5vw, 44px);
      font-weight: 700;
      color: var(--white);
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .hero p {
      font-size: 18px;
      color: #c4a8f0;
      max-width: 560px;
      margin: 0 auto 32px;
    }
    .hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btn-primary {
      background: var(--white);
      color: var(--purple-dark);
      padding: 14px 28px;
      border-radius: 6px;
      font-size: 15px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      text-decoration: none;
    }
    .btn-primary:hover { background: var(--purple-light); }
    .btn-secondary {
      background: transparent;
      color: var(--white);
      padding: 14px 28px;
      border-radius: 6px;
      font-size: 15px;
      font-weight: 600;
      border: 2px solid rgba(255,255,255,0.5);
      cursor: pointer;
      text-decoration: none;
    }
    .btn-secondary:hover { border-color: var(--white); background: rgba(255,255,255,0.08); }

    /* Sections */
    section { padding: 64px 32px; }
    .section-inner { max-width: 960px; margin: 0 auto; }
    .section-title { font-size: 30px; font-weight: 700; text-align: center; margin-bottom: 8px; color: var(--purple-dark); }
    .section-sub { font-size: 16px; color: var(--gray-mid); text-align: center; margin-bottom: 40px; }

    /* Services */
    .services { background: var(--white); }
    .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); gap: 20px; }
    .service-card {
      background: var(--gray-light);
      border: 1px solid #e2d9f3;
      border-radius: 10px;
      padding: 24px 20px;
      border-top: 3px solid var(--purple-accent);
    }
    /* Icons: Lucide (lucide.dev) - ISC license - inlined, no runtime dependency */
    .service-icon { margin-bottom: 14px; line-height: 0; color: var(--purple-mid); }
    .service-icon svg { width: 34px; height: 34px; display: block; }
    .service-card h3 { font-size: 16px; font-weight: 600; margin-bottom: 8px; color: var(--purple-dark); }
    .service-card p { font-size: 14px; color: var(--gray-mid); line-height: 1.6; }

    /* Why us */
    .why { background: var(--purple-dark); padding: 48px 32px; }
    .why-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 32px;
      max-width: 960px;
      margin: 0 auto;
    }
    .why-item h3 {
      font-size: 17px;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 8px;
    }
    .why-item p { font-size: 14.5px; color: #c4a8f0; line-height: 1.7; }

    /* About */
    .about { background: var(--purple-light); }
    .about-inner { max-width: 640px; margin: 0 auto; text-align: center; }
    .about-inner p { font-size: 16px; color: var(--gray-dark); line-height: 1.8; }
    .about-inner p + p { margin-top: 18px; }
    .service-area {
      max-width: 640px;
      margin: 32px auto 0;
      padding-top: 24px;
      border-top: 1px solid #ddd0f5;
      font-size: 14px;
      color: var(--gray-mid);
      text-align: center;
      line-height: 1.7;
    }
    .service-area strong { color: var(--purple-dark); font-weight: 600; }

    /* Contact */
    .contact { background: var(--white); }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      max-width: 720px;
      margin: 0 auto;
    }
    .contact-info h3 { font-size: 18px; font-weight: 600; margin-bottom: 20px; color: var(--purple-dark); }
    .contact-item { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; font-size: 15px; color: var(--gray-dark); }
    .contact-item .icon { color: var(--purple-accent); display: flex; align-items: center; justify-content: center; min-width: 20px; }
    .contact-item .icon svg { width: 20px; height: 20px; display: block; }
    /* solid brand mark reads heavier than a 2px stroke, so size it down optically */
    .contact-item .icon svg.brand { width: 18px; height: 18px; fill: currentColor; }
    .contact-form { display: flex; flex-direction: column; gap: 12px; }
    .contact-form input,
    .contact-form textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
      background: var(--gray-light);
    }
    .contact-form input:focus,
    .contact-form textarea:focus { outline: 2px solid var(--purple-accent); border-color: transparent; }
    .contact-form textarea { height: 100px; resize: vertical; }
    .sms-consent {
      font-size: 11.5px;
      line-height: 1.5;
      color: var(--gray-mid);
      text-align: center;
    }
    .sms-consent a { color: var(--purple-mid); text-decoration: underline; }
    .contact-form button {
      background: var(--purple-mid);
      color: var(--white);
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
    }
    .contact-form button:hover { background: var(--purple-dark); }

    /* Footer */
    footer {
      padding: 24px 32px;
      background: var(--purple-dark);
      text-align: center;
      font-size: 13px;
      color: #c4a8f0;
    }
    footer a { color: var(--white); }

    @media (max-width: 600px) {
      nav { padding: 12px 16px; }
      .hero { padding: 56px 20px; }
      section { padding: 48px 20px; }
      .why { padding: 40px 20px; }
      .why-grid { gap: 24px; }
      .contact-grid { grid-template-columns: 1fr; gap: 32px; }
    }
  </style>
</head>
<body>

  <nav>
    <a href="/" class="logo">
      <img src="/GCIT-Skyline-Logo.png" alt="Gate City IT" />
    </a>
    <a href="tel:+13367431880" class="nav-cta">Call us</a>
  </nav>

  <section class="hero">
    <h1>Expert IT support for<br />Triad area small businesses</h1>
    <p>Managed IT, cybersecurity, and help desk support for Greensboro-area businesses. We keep your technology running so you can get on with your work.</p>
    <div class="hero-btns">
      <a href="tel:+13367431880" class="btn-primary">(336) 743-1880</a>
      <a href="#contact" class="btn-secondary">Book a Free Consultation</a>
    </div>
  </section>

  <section class="services">
    <div class="section-inner">
      <h2 class="section-title">What We Do</h2>
      <p class="section-sub">Everything a small business needs from an IT department, without hiring one</p>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /> <path d="m9 12 2 2 4-4" /> </svg></div>
          <h3>Cybersecurity</h3>
          <p>Endpoint protection, email filtering, and monitoring that catches problems before they reach your team.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z" /> <path d="M21 16v2a4 4 0 0 1-4 4h-5" /> </svg></div>
          <h3>Help desk support</h3>
          <p>Fast, friendly help by phone, email, or the helpdesk app, from people who already know your setup.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" /> </svg></div>
          <h3>Cloud services</h3>
          <p>Microsoft 365, SharePoint, and cloud infrastructure set up properly and managed day to day.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="14" x="2" y="3" rx="2" /> <line x1="8" x2="16" y1="21" y2="21" /> <line x1="12" x2="12" y1="17" y2="21" /> </svg></div>
          <h3>Managed devices</h3>
          <p>Every workstation and server kept patched, updated, and running the way it should.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><ellipse cx="12" cy="5" rx="9" ry="3" /> <path d="M3 12a9 3 0 0 0 5 2.69" /> <path d="M21 9.3V5" /> <path d="M3 5v14a9 3 0 0 0 6.47 2.88" /> <path d="M12 12v4h4" /> <path d="M13 20a5 5 0 0 0 9-3 4.5 4.5 0 0 0-4.5-4.5c-1.33 0-2.54.54-3.41 1.41L12 16" /> </svg></div>
          <h3>Backup &amp; disaster recovery</h3>
          <p>Automated backups, tested restores, and a documented recovery plan, so a failed drive or a ransomware hit doesn&rsquo;t close you for the week.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h.01" /> <path d="M2 8.82a15 15 0 0 1 20 0" /> <path d="M5 12.859a10 10 0 0 1 14 0" /> <path d="M8.5 16.429a5 5 0 0 1 7 0" /> </svg></div>
          <h3>Networks &amp; Wi-Fi</h3>
          <p>Firewalls, switching, business Wi-Fi, and secure remote access. Designed, installed, and maintained.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" /> </svg></div>
          <h3>Business phone systems</h3>
          <p>Hosted VoIP with number porting, call routing, voicemail to email, and mobile apps for the road.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="8" height="4" x="8" y="2" rx="1" ry="1" /> <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /> <path d="m9 14 2 2 4-4" /> </svg></div>
          <h3>IT consulting &amp; compliance</h3>
          <p>Budget planning, hardware roadmaps, and help meeting HIPAA, PCI, and cyber insurance requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="why">
    <div class="why-grid">
      <div class="why-item">
        <h3>20+ years in IT</h3>
        <p>Two decades of hands-on work with the networks, servers, and software that small businesses run on.</p>
      </div>
      <div class="why-item">
        <h3>On-site and remote</h3>
        <p>Most issues get fixed remotely in minutes. When a job needs hands on the hardware, we come to you.</p>
      </div>
      <div class="why-item">
        <h3>Built for SMBs</h3>
        <p>Big enough that downtime costs you real money, small enough that a full-time IT hire makes no sense.</p>
      </div>
    </div>
  </section>

  <section class="about">
    <div class="about-inner">
      <h2 class="section-title">About Gate City IT</h2>
      <p class="section-sub">Local experts, personal service</p>
      <p>Gate City IT is a Greensboro-based IT company bringing enterprise-grade technology support to small and medium businesses at a price that fits a small business budget. When you call, you talk to someone who already knows your network, your software, and how your business runs.</p>
      <p>We handle most work remotely, so problems get solved the same day. When a job needs someone on site, whether that&rsquo;s a dead switch, a new office build-out, or a server that won&rsquo;t come back up, we&rsquo;re close by.</p>
      <p class="service-area">
        <strong>Where we work:</strong> Greensboro, High Point, Winston-Salem, Burlington,
        Kernersville, Jamestown, Oak Ridge, and Summerfield, with remote support available
        anywhere in North Carolina.
      </p>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="section-inner">
      <h2 class="section-title">Get In Touch</h2>
      <p class="section-sub">Tell us what&rsquo;s giving you trouble and we&rsquo;ll tell you how we&rsquo;d fix it</p>
      <div class="contact-grid">
        <div class="contact-info">
          <h3>Contact us directly</h3>
          <div class="contact-item">
            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" /> </svg></span>
            <a href="tel:+13367431880">(336) 743-1880</a>
          </div>
          <div class="contact-item">
            <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /> <rect x="2" y="4" width="20" height="16" rx="2" /> </svg></span>
            <a href="mailto:info@gatecityit.com">info@gatecityit.com</a>
          </div>
          <div class="contact-item">
            <span class="icon"><svg class="brand" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.268c-.966 0-1.75-.784-1.75-1.75s.784-1.75 1.75-1.75 1.75.784 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.268h-3v-5.604c0-1.337-.027-3.061-1.865-3.061-1.865 0-2.151 1.457-2.151 2.963v5.702h-3v-10h2.881v1.367h.041c.401-.761 1.381-1.563 2.844-1.563 3.042 0 3.604 2.002 3.604 4.604v5.592z"/></svg></span>
            <a href="https://www.linkedin.com/company/gatecityit" target="_blank" rel="noopener">Find us on LinkedIn</a>
          </div>
        </div>
        <form class="contact-form" name="contact" method="POST" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value="48182325-7d17-4172-9472-4bb2f434c566" />
          <input type="hidden" name="subject" value="New contact form submission - Gate City IT" />
          <input type="checkbox" name="botcheck" style="display:none" />
          <input type="text" name="name" placeholder="Your name" required />
          <input type="email" name="email" placeholder="Email address" required />
          <input type="tel" name="phone" placeholder="Phone number" />
          <textarea name="message" placeholder="How can we help?"></textarea>
          <button type="submit">Send message →</button>
          <input type="hidden" name="sms_consent" value="Accepted via form submission" />
          <p class="sms-consent">
            By submitting this form, you agree to receive text messages from Gate City IT
            at the phone number provided. Messages relate to your support requests,
            scheduling, and service updates. Message frequency varies. Message and data
            rates may apply. Reply STOP to opt out or HELP for help. See our
            <a href="/privacy-policy">Privacy policy</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

<footer>
